# LiveKit Cloud credentials — get them from https://cloud.livekit.io
# Used by the Next.js token endpoint (src/app/api/token/route.ts) and the Python agent.
LIVEKIT_URL=wss://your-project.livekit.cloud
LIVEKIT_API_KEY=your-api-key
LIVEKIT_API_SECRET=your-api-secret

# Optional: pin the default room name. Leave unset to get a fresh `va_room_*`
# per page load, which is what the web app wants — it is a session, not a
# shared channel.
#LIVEKIT_ROOM=agentsuite

# Optional: Python agent worker name (defaults to "fieldwork-assistant").
# Must match the agent name the web token dispatches (see agent/agent.py).
# LIVEKIT_AGENT_NAME=fieldwork-assistant

# Optional: port for the Python agent worker (defaults to 8080)
# AGENT_PORT=8080

# Optional: show the like/dislike controls in chat — the pair under a finished
# answer and the rating bar at the end of a session. Off unless this is set to
# `1` or `true`; anything else counts as off. Read by the server on every
# request, so changing it needs the server to pick up the new environment — no
# rebuild, and a reload of the page is enough to see it.
# SHOW_FEEDBACK=1

# Optional: the questions the composer completes toward, and the slash commands it
# offers. An http(s) URL returning JSON — the only two shapes read are
# `{"samples": [...], "commands": [...]}` and a bare array of samples. Each sample
# is `{"id?", "question", "title?", "subtitle?"}` and each command is
# `{"key", "hint?", "prompt?"}`; entries missing a `question` or a typable `key`
# are dropped, and a corpus the service omits falls back to the ones bundled in
# `src/lib/completion/`. Leave it unset and the bundled set is used, which is what
# local development wants — nothing to stand up.
# AUTOCOMPLETE_API_URL=https://portal.internal/api/completions

# Optional: a model key for the composer's autocompletion. The samples and
# commands cover what this agent is good at, and a prefix of one of them completes
# with no model at all; this only covers a draft that has stopped looking like any
# of them, where the grey text at the caret comes from `/api/complete`. Leave it
# unset and the local corpora still work, and there is simply no ghost for a draft
# of your own — the route answers 503 and the composer says nothing about it.
# AI_GATEWAY_API_KEY=your-vercel-ai-gateway-key

# Optional: which model `/api/complete` uses. Any Vercel AI Gateway model id in
# `provider/model` form. Only read when a gateway key is set.
# AUTOCOMPLETE_MODEL=openai/gpt-4o-mini

# --- Python agent (agent/agent.py) -------------------------------------------
# The agent worker uses these same credentials. Set LIVEKIT_* here, copy this file
# into agent/ as .env.local (agent.py calls load_dotenv() from the agent/ cwd), or
# export them in the shell. See the top-level README for details.